.container {
    background-image: resource('LevelAssets/SpaceTrash/Images/Background');
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    -unity-font-style: normal;
}

.group-item {
    flex-direction: row;
    flex-wrap: nowrap;
    align-self: center;
    align-items: center;
    margin-top: 38px;
    margin-bottom: 38px;
}

.switch {
    background-color: rgb(231, 231, 235);
    border-left-color: rgb(23, 111, 170);
    border-right-color: rgb(23, 111, 170);
    border-top-color: rgb(23, 111, 170);
    border-bottom-color: rgb(23, 111, 170);
    width: 264px;
    align-self: center;
    height: 88px;
    border-top-left-radius: 42px;
    border-top-right-radius: 42px;
    border-bottom-right-radius: 42px;
    border-bottom-left-radius: 42px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    margin-top: 0;
    overflow: visible;
}

.label {
    width: 542px;
    color: rgb(255, 255, 255);
    font-size: 35px;
    -unity-font: url('project://database/Assets/TextMesh%20Pro/Fonts/chalkboard-se-light.ttf?fileID=12800000&guid=d113419e616c9024796ad9dc3eca82c6&type=3#chalkboard-se-light');
    -unity-font-style: bold;
}

.switch .toggle {
    background-color: rgba(243, 242, 242, 0);
    width: 156px;
    height: 136px;
    border-top-left-radius: 47px;
    border-top-right-radius: 47px;
    border-bottom-right-radius: 47px;
    border-bottom-left-radius: 47px;
    position: absolute;
    top: -28px;
    align-self: flex-start;
    justify-content: flex-start;
    align-items: stretch;
    left: -6px;
    background-image: resource('LevelAssets/BoatAdventure/Images/_0009_blueMigclosed');
    transition-timing-function: ease-in-out;
    transition-duration: 0.25s;
    transition-property: left;
}

.switch.on .toggle {
    left: 110px;
    background-image: resource('LevelAssets/BoatAdventure/Images/_0010_blueMigOpen');
}
