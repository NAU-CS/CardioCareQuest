TextField:focus {
    color: rgb(0, 0, 0);
}

.first-div {
    background-size: cover;
    background-repeat: no-repeat;
}

.form-elements-spacing {
    padding: 10px 0;
    color: black;
    margin: 0 auto;
    width: 80%;
    font-size: 24px;
    padding: 15px 20px;
}

.customBackground {
    background-color: rgba(28, 23, 42, 0.66);
    border-radius: 5px;
}

.form-elements-spacing:focus {
    color: black;
}

.form-elements-spacing:hover {
    color: black;
}

.form-elements-spacing:active {
    color: black;
}

DropdownField.form-elements-spacing {
    color: white;
    flex-direction: column;
}

DropdownField.form-elements-spacing {
    color: white;
}

DropdownField.form-elements-spacing Label {
    color: white;
}

#consent-button.form-elements-spacing {
    color: white;
    width: auto;
    margin-right: auto;
}

DropdownField.form-elements-spacing PopupTextElement {
    background-color: rgba(47, 40, 71, 0.04);
    color: black;
    padding: 5px;
}

#player-greetings {
    color: white;
    font-size: 45px;
    letter-spacing: 1px;
}

#account-details {
    display: none;
}

.marginTop {
    margin-top: 20px;
}

#consent-proposal {
    color: white;
    margin-top: 40px;
    -unity-text-align: middle-center;
}

#accessBar {
    background-color: rgb(47, 40, 71);
    padding: 10px;
    border-radius: 5px;
}

#profile-header {
    background-color: rgb(47, 40, 71);
    padding: 10px;
    border-radius: 5px;
}

.card {
    background-color: rgb(47, 40, 71);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 5px;
    width: 400px;
    height: 300px;
    padding: 10px;
    justify-content: center;
    margin: 10px;
}

.profile-popup {
    background-color: rgb(47, 40, 71);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 5px;
    color: white;
    width: auto;
}

#view-account-details {
    background-color: rgb(47, 40, 71);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 5px;
    color: white;
    width: auto;
}

#new-profile {
    background-color: rgb(47, 40, 71);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 5px;
    color: white;
    width: auto;
}

#submit {
    background-color: rgb(47, 40, 71);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 5px;
    color: white;
    width: auto;
}

#t-n-c-details {
    background-color: rgb(47, 40, 71);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 5px;
    color: white;
    width: auto;
}

#profileCards {
    align-items: center;
}

.card .profile-popup {
    margin: 5px auto;
}
