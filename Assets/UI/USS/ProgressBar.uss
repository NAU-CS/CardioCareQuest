.unity-progress-bar__background {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(238, 238, 238, 0.5);
}

.unity-progress-bar__progress {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-background-image-tint-color: rgb(31, 28, 28);
    background-color: rgb(35, 29, 29);
}

.unity-progress-bar {
    width: 100%;
    height: 16px;
    margin-top: 38px;
    margin-right: 4px;
    margin-bottom: 20px;
    margin-left: 4px;
    padding-top: 0;
    padding-right: 32px;
    padding-bottom: 0;
    padding-left: 32px;
}
