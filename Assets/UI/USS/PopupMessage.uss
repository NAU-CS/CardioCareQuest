.popup-title {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.popup-message {
    font-size: 30px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: upper-center;
}
