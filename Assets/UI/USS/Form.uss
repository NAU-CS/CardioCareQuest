.unity-base-field {
    flex-direction: column;
    font-size: 40px;
    margin-top: 0;
    padding: 16px 32px;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(188, 188, 188);
}

.unity-label {
    color: rgb(255, 255, 255);
    font-size: 40px;
    white-space: normal;
}

.unity-base-field__input {
    background-color: rgb(224, 221, 221);
    border-radius: 12px;
    height: 116px;
    -unity-text-align: middle-left;
    justify-content: center;
    display: flex;
    font-size: 40px;
}

.multi-select-dropdown {
    background-color: rgb(224, 221, 221);
    height: auto;
    width: auto;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: -17px;
    margin-right: 44px;
    margin-bottom: 0;
    margin-left: 44px;
    max-height: 352px;
    font-size: 40px;
}

.unity-toggle {
    flex-direction: row-reverse;
    justify-content: flex-end;
    -unity-text-align: middle-left;
}

.unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    margin-right: 12px;
    margin-left: 12px;
    width: auto;
    height: auto;
}

.unity-toggle__label {
    font-size: 40px;
    -unity-font-style: normal;
    color: rgb(0, 0, 0);
    margin-left: 12px;
    margin-right: 12px;
}

.scroll-view {
    margin-top: -11px;
}

.button {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 7px;
    border-bottom-width: 7px;
    border-left-width: 1px;
}

.form {
    flex-grow: 1;
    width: 100%;
    max-width: 1536px;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
    padding-top: 25px;
    padding-right: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
    background-image: resource('LevelAssets/SpaceTrash/Images/Background');
    -unity-background-image-tint-color: rgba(112, 101, 231, 0.57);
    border-top-left-radius: 64px;
    border-top-right-radius: 64px;
    border-bottom-right-radius: 64px;
    border-bottom-left-radius: 64px;
}

.form-wrapper {
    flex-grow: 1;
}

.unity-button {
    padding-top: 30px;
    padding-right: 48px;
    padding-bottom: 30px;
    padding-left: 48px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    background-color: rgb(47, 40, 71);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}

.dropdown-popup-text {
    color: rgb(0, 0, 0);
    font-size: 40px;
}

.unity-toggle__checkmark {
    width: 40px;
    height: 40px;
}

.unity-base-slider--vertical {
    margin-left: -32px;
    margin-top: 6px;
}
