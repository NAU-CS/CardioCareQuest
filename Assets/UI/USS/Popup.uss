.title {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-top: 42px;
    margin-right: 42px;
    margin-bottom: 42px;
    margin-left: 42px;
}

.message {
    width: 70%;
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 4px;
    padding-right: 2px;
    padding-bottom: 4px;
}

.button {
    width: 400px;
    height: 80px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(42, 23, 48);
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 10px;
}
