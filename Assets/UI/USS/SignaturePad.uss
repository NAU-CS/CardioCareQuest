.title {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 56px;
    color: rgb(255, 255, 255);
}

.button {
    width: 220px;
    height: 80px;
    margin-top: 20px;
    margin-right: 10px;
    margin-bottom: 20px;
    margin-left: 10px;
    font-size: 30px;
}
