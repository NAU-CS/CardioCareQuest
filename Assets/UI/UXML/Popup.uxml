<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/Popup.uss?fileID=7433441132597879392&amp;guid=285a32660d7eda149a26e43727751ba8&amp;type=3#Popup" />
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:VisualElement name="container" style="flex-grow: 0; width: 1080px; height: 680px; justify-content: center; align-items: center; background-image: resource(&apos;LevelAssets/SpaceTrash/Images/Background&apos;); border-top-left-radius: 64px; border-top-right-radius: 64px; border-bottom-right-radius: 64px; border-bottom-left-radius: 64px; display: none;">
            <ui:Label tabindex="-1" text="Error" parse-escape-sequences="true" display-tooltip-when-elided="true" name="title" class="title" />
